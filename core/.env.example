# ═══════════════════════════════════════════════════════════════════════════
# Configuration Django — Yessal Gui
# ═══════════════════════════════════════════════════════════════════════════
# Copier en core/.env.local (développement) ou renseigner ces variables dans
# l'environnement du service (production).
#
# Les variables marquées OBLIGATOIRE EN PROD font échouer le démarrage si elles
# manquent alors que DEBUG=False. C'est voulu : une application qui démarre avec
# une clé de démonstration ou un webhook de paiement non authentifié est pire
# qu'une application qui refuse de démarrer.

# ── Django ────────────────────────────────────────────────────────────────
# OBLIGATOIRE EN PROD. 50 caractères aléatoires minimum. Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=changeme_a_une_valeur_secrete_super_longue_et_aleatoire

# ── Base de données (PostgreSQL) ──────────────────────────────────────────
DB_NAME=yessal_database
DB_USER=postgres
DB_PASSWORD=changeme_mot_de_passe_secure
DB_HOST=localhost
DB_PORT=5432

# ── Déploiement et sécurité ───────────────────────────────────────────────
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Redirection HTTPS, HSTS et cookies « secure » s'activent automatiquement
# dès que DEBUG=False. À ne mettre à False que derrière un proxy qui termine
# déjà le TLS ET redirige lui-même.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── CORS ──────────────────────────────────────────────────────────────────
# Le défaut suit DEBUG : ouvert en local, fermé en production. Laisser
# CORS_ALLOW_ALL_ORIGINS=False et énumérer les origines du front, sinon
# n'importe quel site peut appeler l'API avec le jeton d'un visiteur.
# En production, une liste vide empêche le démarrage.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Limitation de débit (DRF) ─────────────────────────────────────────────
# Freine le bourrage d'identifiants et l'aspiration de l'annuaire.
THROTTLE_ANON=60/min
THROTTLE_USER=1000/hour

# ── Journalisation ────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Courrier sortant ──────────────────────────────────────────────────────
# EMAIL_HOST vide ⇒ Django bascule sur le backend « console » : les messages
# s'affichent dans le terminal au lieu de partir. C'est le défaut, et c'est
# voulu — un développeur qui clone le dépôt n'envoie rien à personne.
#
# GMAIL : le mot de passe du compte ne fonctionne PAS depuis 2022. Il faut un
# MOT DE PASSE D'APPLICATION de 16 caractères, créé sur
# https://myaccount.google.com/apppasswords après activation de la validation
# en deux étapes. Sans lui : « 535 Username and Password not accepted ».
# Limite d'envoi Gmail : ~500 destinataires par jour.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_USE_TLS=True

# Expéditeur affiché. En production, une adresse du domaine de l'organisation,
# avec SPF/DKIM/DMARC configurés — sinon les messages partent en indésirables.
DEFAULT_FROM_EMAIL=no-reply@yessal.sn
EMAIL_FROM_NAME=Yessal Gui

# Adresse de réponse : la boîte d'envoi n'écoute pas. Sans « Reply-To », la
# réponse d'un membre se perd en silence.
EMAIL_REPLY_TO=contact@yessalgui.sn

# Coupe-circuit global. False = le code s'exécute et journalise ce qui AURAIT
# été envoyé, sans rien émettre. À utiliser dès qu'on travaille sur une copie
# de la base de production.
EMAIL_ENABLED=True

# Validité d'un lien de réinitialisation de mot de passe, en secondes.
PASSWORD_RESET_TIMEOUT=86400

# Vérifier la configuration :
#   python manage.py send_test_email vous@exemple.com
#   python manage.py send_test_email vous@exemple.com --code mot_de_passe_oublie
# Catalogue des courriels : docs/EMAILS.md

# ── Stockage objet S3 (optionnel) ─────────────────────────────────────────
# Sur un hébergeur au disque éphémère (Render), les fichiers téléversés
# disparaissent à chaque redéploiement sans stockage objet.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=yessal-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000

# ── Téléversements ────────────────────────────────────────────────────────
# Doit rester aligné avec MAX_FILE_SIZE_MB (components/vireo/FileDrop.tsx) et
# serverActions.bodySizeLimit (next.config.ts). 15 Mo par défaut.
MAX_UPLOAD_SIZE=15728640

# ── Messagerie temps réel (Pusher) ────────────────────────────────────────
# Sans ces trois valeurs, le temps réel est désactivé proprement — l'écrit et
# la lecture des messages continuent de fonctionner. Aucune valeur de repli
# n'est codée en dur : un secret dans le dépôt est un secret public.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
PUSHER_SSL=True

# ── Notifications push (Firebase) ─────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase/firebase-sa.json

# ── Coordonnées bancaires (virements) ─────────────────────────────────────
BANK_NAME=BICIS
BANK_IBAN=SN28 XXXX XXXX XXXX XXXX XXXX XXX
BANK_BIC=BICISSND
BANK_ACCOUNT_NAME=Association Yessal Gui
BANK_REFERENCE_FORMAT=YG-{member_id}-{date}

# ── Passerelle de paiement (Bictorys) ─────────────────────────────────────
# BICTORYS_WEBHOOK_SECRET est OBLIGATOIRE EN PROD dès que les clés publique et
# secrète sont renseignées : le webhook d'encaissement authentifie chaque appel
# avec, et refuse tout si la valeur manque. Sans ce contrôle, n'importe qui
# pourrait marquer un don comme payé.
BICTORYS_PUBLIC_KEY=
BICTORYS_SECRET_KEY=
BICTORYS_WEBHOOK_SECRET=
BICTORYS_BASE_URL=https://api.test.bictorys.com

# ── Deux URL publiques, à ne pas confondre ────────────────────────────────
# BASE_URL désigne le FRONT : c'est ce que suivent les membres depuis un
# courriel (/dashboard, /login, /dashboard/profile). Le pointer sur le backend
# donne des liens qui n'aboutissent nulle part.
#   dev : http://localhost:3100   (WEB_PORT du .env racine)
BASE_URL=https://yessalgui.sn

# EMAIL_ASSETS_URL désigne le BACKEND : les illustrations des courriels sont
# servies depuis static/emails/illustrations/. Une boîte mail ne sait pas
# résoudre un chemin relatif — il faut une URL absolue et publiquement
# joignable.
#   dev : http://localhost:8000/static/emails/illustrations
#
# NB : en test local, Gmail relaie les images par ses propres serveurs et
# n'atteindra jamais un « localhost ». Les images resteront vides tant que le
# backend n'est pas exposé publiquement — ce n'est pas un défaut du gabarit.
EMAIL_ASSETS_URL=https://api.yessalgui.sn/static/emails/illustrations

# ── Supervision (optionnel) ───────────────────────────────────────────────
SENTRY_DSN=
